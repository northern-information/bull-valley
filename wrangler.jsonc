{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bull-valley-shadow-wars",
  // The Northern Information account. Pinned so local wrangler commands
  // reach it when the login can see several accounts, and so CI needs only
  // the organization's CLOUDFLARE_API_TOKEN.
  "account_id": "cbe8e84757316e274a5960cf13836119",
  // The Worker is bundled by @cloudflare/vite-plugin; `vite build` writes
  // the deployable config under dist/ and points `wrangler deploy` at it.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The game lives at https://bvsw.gay, a Workers Custom Domain on the
  // zone in the same account: deploying creates the DNS record and the
  // certificate, and a deploy from CI (no TTY) replaces whatever record is
  // on the hostname. The workers.dev URL stays on as a fallback.
  "routes": [{ "pattern": "bvsw.gay", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  // The client bundle. The plugin fills in the directory from the build.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  // One valley for everyone; see src/protocol.ts VALLEY_NAME.
  "durable_objects": {
    "bindings": [{ "name": "VALLEY", "class_name": "ValleyDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ValleyDO"] }],
  // Where sign-in round trips land and what the OAuth providers redirect
  // back to. A dev server uses its own origin instead (worker/env.ts).
  "vars": {
    "APP_ORIGIN": "https://bvsw.gay",
  },
  // Accounts, linked providers and usernames (worker/d1accounts.ts). The
  // schema is migrations/*.sql; the deploy workflow applies it before each
  // deploy, and `npm run db:migrate` applies it to the dev server's copy.
  // The secrets beside it (JWT_SECRET and each provider's client id and
  // secret) are set with `wrangler secret put`, never written here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bull-valley-accounts",
      "database_id": "REPLACE-WITH-THE-ID-FROM-wrangler-d1-create",
      "migrations_dir": "migrations",
    },
  ],
}
